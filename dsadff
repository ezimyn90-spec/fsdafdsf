local chamsEnabled = false
local namesEnabled = false

local function getTeamColor(player)
    if not player.Team then return Color3.fromRGB(255, 255, 255) end
    local name = player.Team.Name
    if name == "Guards" then return Color3.fromRGB(0, 140, 255)
    elseif name == "Inmates" then return Color3.fromRGB(255, 140, 0)
    elseif name == "Criminals" then return Color3.fromRGB(255, 40, 40) end
    return Color3.fromRGB(220, 220, 220)
end

