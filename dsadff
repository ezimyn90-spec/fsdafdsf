local function switchTab(tabName, targetBtn)
    for name, page in pairs(pages) do
        page.Visible = (name == tabName)
    end
    for _, btn in ipairs(Sidebar:GetChildren()) do
        if btn:IsA("TextButton") then
            local active = (btn == targetBtn)
            TweenService:Create(btn, TweenInfo.new(0.2), {
                BackgroundColor3 = active and Color3.fromRGB(99, 102, 241) or Color3.fromRGB(22, 22, 30),
                TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 160, 175)
            }):Play()
        end
    end
end

