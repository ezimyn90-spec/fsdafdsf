RunService.RenderStepped:Connect(function()
    if speedEnabled then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        if hum then hum.WalkSpeed = 34 end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChild("Humanoid")

            -- Chams
            if chamsEnabled and hum and hum.Health > 0 then
                local hl = char:FindFirstChild("SolaraHighlight")
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "SolaraHighlight"
                    hl.FillTransparency = 0.4
                    hl.OutlineTransparency = 0
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = char
                end
                hl.FillColor = getTeamColor(p)
            else
                if char:FindFirstChild("SolaraHighlight") then
                    char.SolaraHighlight:Destroy()
                end
            end

            -- ESP Tags
            if namesEnabled and head and hum and hum.Health > 0 then
                local tag = head:FindFirstChild("SolaraTag")
                if not tag then
                    tag = Instance.new("BillboardGui")
                    tag.Name = "SolaraTag"
                    tag.Size = UDim2.new(0, 120, 0, 30)
                    tag.AlwaysOnTop = true
                    tag.ExtentsOffset = Vector3.new(0, 2.5, 0)
                    tag.Parent = head

                    local text = Instance.new("TextLabel")
                    text.Name = "Label"
                    text.Size = UDim2.new(1, 0, 1, 0)
                    text.BackgroundTransparency = 1
                    text.Font = Enum.Font.GothamBold
                    text.TextSize = 11
                    text.TextColor3 = getTeamColor(p)
                    text.TextStrokeTransparency = 0.3
                    text.Parent = tag
                end
                local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local dist = myHrp and math.floor((myHrp.Position - head.Position).Magnitude) or 0
                tag.Label.Text = string.format("%s\n[%d m]", p.DisplayName, dist)
                tag.Label.TextColor3 = getTeamColor(p)
            else
                if head and head:FindFirstChild("SolaraTag") then
                    head.SolaraTag:Destroy()
                end
            end
        end
    end
end)

