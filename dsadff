-- 7. Вкладка "Бой" (Стабильные Хитбоксы и Silent Aim)
-- -------------------------------------------------------------
local silentAimEnabled = false
local hitboxEnabled = false
local hitboxVisuals = false
local currentHitboxSize = 7

local function isEnemy(player)
    if player == LocalPlayer or not player.Character then return false end
    if not LocalPlayer.Team or not player.Team then return true end

    local myTeam = LocalPlayer.Team.Name
    local theirTeam = player.Team.Name

    if myTeam == "Guards" then
        return theirTeam == "Inmates" or theirTeam == "Criminals"
    elseif myTeam == "Inmates" or myTeam == "Criminals" then
        return theirTeam == "Guards"
    end
    return myTeam ~= theirTeam
end

local function updatePlayerHitbox(p)
    if not isEnemy(p) or not p.Character then return end
    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
    local hum = p.Character:FindFirstChild("Humanoid")
    if hrp and hum and hum.Health > 0 then
        local targetSize = Vector3.new(currentHitboxSize, currentHitboxSize, currentHitboxSize)
        if hrp.Size ~= targetSize then
            hrp.Size = targetSize
            hrp.CanCollide = false
            hrp.Massless = true
        end

        if hitboxVisuals then
            if hrp.Transparency ~= 0.75 then
                hrp.Transparency = 0.75
                hrp.BrickColor = BrickColor.new("Bright red")
                hrp.Material = Enum.Material.Neon
            end
        else
            if hrp.Transparency ~= 1 then
                hrp.Transparency = 1
            end
        end
    end
end

local function restorePlayerHitbox(p)
    if not p.Character then return end
    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Size = Vector3.new(2, 2, 1)
        hrp.Transparency = 1
        hrp.CanCollide = false
    end
end

createToggle(combatPage, "Silent Aim (В голову)", false, function(v) silentAimEnabled = v end)

createToggle(combatPage, "Увеличение Хитбоксов", false, function(v)
    hitboxEnabled = v
    if not v then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then restorePlayerHitbox(p) end
        end
    else
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then updatePlayerHitbox(p) end
        end
    end
end)

createToggle(combatPage, "Показ Хитбоксов (Красный неон)", false, function(v)
    hitboxVisuals = v
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isEnemy(p) and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if hitboxVisuals and hitboxEnabled then
                    hrp.Transparency = 0.75
                    hrp.BrickColor = BrickColor.new("Bright red")
                    hrp.Material = Enum.Material.Neon
                else
                    hrp.Transparency = 1
                end
            end
        end
    end
end)

